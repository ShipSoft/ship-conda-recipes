{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>ShipSoft/.github"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions in rattler-build recipes (GitHub template sources)",
      "managerFilePatterns": ["/recipe\\.yaml$/"],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "context:\\n\\s+version:\\s*\"(?<currentValue>[^\"]+)\"",
        "url:\\s*https://github\\.com/(?<packageName>[^/]+/[^/]+)/archive/"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update versions in rattler-build recipes (GitLab CERN template sources)",
      "managerFilePatterns": ["/recipe\\.yaml$/"],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "context:\\n\\s+version:\\s*\"(?<currentValue>[^\"]+)\"",
        "url:\\s*https://gitlab\\.cern\\.ch/(?<packageName>[^/]+/[^/]+)/-/archive/"
      ],
      "datasourceTemplate": "gitlab-tags",
      "registryUrlTemplate": "https://gitlab.cern.ch",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "field-service: the combination manager above latches onto the vendored covfie source, so match the field_service URL explicitly",
      "managerFilePatterns": ["/(^|/)recipes/field-service/recipe\\.yaml$/"],
      "matchStrings": [
        "context:\\n\\s+version:\\s*\"(?<currentValue>[^\"]+)\"[\\s\\S]*?url:\\s*https://github\\.com/(?<packageName>ShipSoft/field_service)/archive/"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Packages pinned to commits, branches or fork tags, not release tags",
      "matchPackageNames": [
        "ShipSoft/ROOTEGPythia6",
        "ShipSoft/pythia6",
        "acts-project/covfie",
        "webbjm/acts"
      ],
      "enabled": false
    }
  ]
}
